# ── 네이버 클라우드 플랫폼 > Application > Maps ─────────────────────────────
# 지도(Dynamic Map) 표시용 Key ID. 브라우저에 노출되는 값이라 콘솔에서 Web 서비스 URL(http://localhost:5173)을 꼭 등록하세요.
VITE_NAVER_MAP_KEY_ID=
# 서버에서 Geocoding / Reverse Geocoding을 부를 때 쓰는 키 (현재는 선택 사항)
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=

# ── 네이버 개발자센터 > 애플리케이션 > 검색 API (지역) ──────────────────────
# 서버에서만 사용합니다. 비워 두면 샘플 식당 10곳으로 검색을 흉내 내는 목(mock) 모드로 동작합니다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# true/false 로 목 모드를 강제할 수 있습니다. 비워 두면 키가 있는지로 자동 판단합니다.
NAVER_MOCK=

# ── 서버 ──────────────────────────────────────────────────────────────────
PORT=3000
# SQLite 파일 경로는 server/prisma/ 기준입니다.
DATABASE_URL="file:./dev.db"
